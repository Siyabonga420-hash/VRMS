# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead --
# do not upload your real .env file to GitHub.

# Get this from your Neon project dashboard -> Connection Details.
# It looks like: postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/vrms?sslmode=require

# Any long random string -- used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Render sets PORT automatically; this is only used when running locally.
PORT=3000
